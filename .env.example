# Copy to .env and fill in. Never commit .env.

# Secret used to sign session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Admin account created on first start (if it does not exist yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# true when the site is served over HTTPS (Secure cookie, HSTS)
COOKIE_SECURE=false

# false = no demo catalog (start empty and add your licensed titles in /#/admin)
SEED_DEMO=true

# Comma-separated origins your videos are served from, e.g. https://cdn.example.com
# Empty = any https origin is allowed by the CSP (convenient for demos, loosen only if needed).
MEDIA_ORIGINS=

# Number of reverse proxies in front of the app (so rate limiting sees real client IPs)
TRUST_PROXY=

# Billing: "mock" = demo checkout that charges nobody (development/demo only!)
#          "none" = checkout disabled; admins can still grant plans (use this in production
#                   until a real payment provider is integrated)
BILLING_PROVIDER=none
